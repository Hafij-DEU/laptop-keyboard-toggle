<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Hafij</vendor>
  <action id="io.github.hafij_bge.ToggleInternalKeyboard.toggle">
    <description>Turn the built-in keyboard on or off</description>
    <message>Authentication is required to turn the built-in keyboard on or off</message>
    <icon_name>input-keyboard</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/toggle-internal-keyboard/helper</annotate>
  </action>
</policyconfig>
