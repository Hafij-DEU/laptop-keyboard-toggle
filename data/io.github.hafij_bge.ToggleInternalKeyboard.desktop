[Desktop Entry]
Name=Toggle Internal Keyboard
Comment=Turn the laptop keyboard on or off
Exec=internal-keyboard
Icon=io.github.hafij_bge.ToggleInternalKeyboard
Terminal=false
Type=Application
Categories=Utility;Settings;HardwareSettings;
Keywords=keyboard;laptop;disable;enable;internal;builtin;
StartupNotify=true
Actions=toggle;

[Desktop Action toggle]
Name=Toggle Now
Exec=internal-keyboard toggle --notify
